local root = workspace:FindFirstChild("npcs")
assert(root and root:IsA("Model"), "Expected Workspace.npcs")
local matched, unknown, seen = {}, {}, {}
for _, part in ipairs(root:GetDescendants()) do
 if part:IsA("BasePart") then
  local hex = palette[part.Name]
  if hex then
   assert(not seen[part.Name], "Duplicate mesh name: " .. part.Name)
   seen[part.Name] = true
   table.insert(matched, {part = part, color = Color3.fromHex(hex)})
  else table.insert(unknown, part.Name) end
 end
end
local missing = {}
for name in pairs(palette) do if not seen[name] then table.insert(missing, name) end end
assert(#unknown == 0, "Unmapped imported meshes: " .. table.concat(unknown, ", "))
assert(#missing == 0, "Missing imported meshes: " .. table.concat(missing, ", "))
assert(#matched == 618, "Expected 618 NPC meshes")
local history = game:GetService("ChangeHistoryService")
local ok, recording = pcall(function() return history:TryBeginRecording("RestoreNpcBlenderColors", "Restore NPC Blender colors") end)
for i, item in ipairs(matched) do
 item.part.Color = item.color
 item.part.Material = Enum.Material.SmoothPlastic
 if i % 100 == 0 then task.wait() end
end
if ok and recording then history:FinishRecording(recording, Enum.FinishRecordingOperation.Commit) end
for _, item in ipairs(matched) do
 assert(item.part.Color:ToHex() == item.color:ToHex(), "Color mismatch: " .. item.part.Name)
end
print("Restored and verified Blender colors on " .. #matched .. " NPC meshes.")

