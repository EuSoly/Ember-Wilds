-- Contrato de rede do jogo (Blink). O limite de slots (40) é InventoryConfig.MAX_SLOTS. Depois de editar, rode `blink net/game`
-- (o scripts/check.sh faz isso) para gerar src/server/Net.luau e src/client/Net.luau.
-- O Blink valida no servidor tudo que chega do cliente (tipos e faixas abaixo).
option ServerOutput = "../src/server/Net.luau"
option ClientOutput = "../src/client/Net.luau"
option Casing = Pascal

-- Um slot ocupado do inventário. IDs de item são os mesmos de Defs/Items.
struct Slot {
	Id: string(1..32),
	Count: u16(1..)
}

map SlotMap = { [u8(1..40)]: Slot }

-- Inventário inteiro (ao entrar ou quando o cliente pede).
event InventorySync {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Capacity: u8(1..40),
		Slots: SlotMap
	}
}

-- Um slot mudou (nil = ficou vazio).
event InventorySlot {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: (u8(1..40), Slot?)
}

-- A capacidade mudou (ganhou a mochila).
event InventoryCapacity {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: u8(1..40)
}

-- O cliente está pronto e pede o inventário inteiro.
event RequestInventory {
	From: Client,
	Type: Reliable,
	Call: SingleAsync
}

-- Mover o conteúdo de um slot para outro (de, para).
event MoveSlot {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: (u8(1..40), u8(1..40))
}

-- Selecionar um slot da hotbar.
event SelectSlot {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: u8(1..10)
}

-- Mudar uma configuração do jogador (Id = id em Defs/Settings). Só o campo do
-- tipo da configuração é lido (number → Number, boolean → Flag, choice →
-- Choice); o servidor valida faixa e opções (SettingsRules) e ignora o inválido.
event SetSetting {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Id: string(1..32),
		Number: f64?,
		Flag: boolean?,
		Choice: string(1..16)?
	}
}

-- Pedido para nascer (botões Jogar / Jogar de novo). KitId = id em Defs/Kits,
-- opcional. O servidor (SpawnService) ignora se o perfil não carregou, se o
-- jogador já está vivo ou nascendo; kit inexistente ou caro demais = nasce sem kit.
event RequestSpawn {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		KitId: string(1..32)?
	}
}

-- Resumo da vida que acabou, para a tela de morte (DeathService.kill).
-- CauseKey = chave de Strings (ex. "death.cause.dev"); Days = ciclos vividos;
-- Points = pontos da vida; Currency = Golden Ember concedida de fato (após tetos).
event LifeEnded {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		CauseKey: string(1..48),
		Days: u16,
		Points: u32,
		Currency: u16
	}
}

-- Coleta (G2). Um golpe acertou um recurso: vai para os jogadores perto, que
-- mostram o tranco, as lasquinhas e o som. Resource pode chegar nil no cliente
-- (fora do streaming). X/Z = ponto do golpe; DirX/DirZ = direção (unitária)
-- do golpe no plano; Material = GatherDef.material.
event ResourceHit {
	From: Server,
	Type: Unreliable,
	Call: SingleAsync,
	Data: struct {
		Resource: Instance?,
		X: f32,
		Z: f32,
		DirX: f32,
		DirZ: f32,
		Material: string(1..16)
	}
}

-- Aviso da coleta para quem bateu (Key = chave de Strings; ItemId = item
-- citado no texto, ex. a picareta que falta).
event GatherNotice {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Key: string(1..48),
		ItemId: string(1..32)?
	}
}

-- Crafting (G3). O cliente só pede uma receita/cancelamento; o servidor confere
-- ingredientes, estação, espaço no inventário e duração.
event RequestCraft {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: string(1..32)
}

event CancelCraft {
	From: Client,
	Type: Reliable,
	Call: SingleAsync
}

-- Estado do craft, mandado SÓ para o dono: os outros jogadores não podem saber
-- que alguém está craftando (seria informação de combate). Recipe nil = parado;
-- Start/Finish em Workspace:GetServerTimeNow().
event CraftProgress {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Recipe: string(1..32)?,
		Start: f64,
		Finish: f64
	}
}

event CraftNotice {
	From: Server,
	Type: Reliable,
	Call: SingleAsync,
	Data: string(1..48)
}

-- Baú (G4). O cliente só pede; o servidor (ChestService) confere baú, distância,
-- slot, quantidade e tipo, e ignora o inválido. O baú pode chegar nil (peça
-- apagada entre o clique e o pedido).
-- Pôr `Count` (1 ou 10) do slot `Slot` do inventário no baú.
event ChestPut {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: struct {
		Chest: Instance?,
		Slot: u8,
		Count: u8
	}
}

-- Tirar do baú o quanto couber no inventário.
event ChestTake {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: Instance?
}

-- Construção livre (G4). Giro escolhido para a próxima peça, em passos de 45°
-- (0..7; BuildRules.ROTATE_STEPS). O servidor (StructureService) só aceita
-- inteiro de 0 a 7 com uma peça na mão, volta a 0 ao trocar de item e calcula
-- ponto e ângulo da peça sozinho.
event SetBuildRotation {
	From: Client,
	Type: Reliable,
	Call: SingleAsync,
	Data: u8
}
