{
  "name": "starve",
  "tree": {
    "$className": "DataModel",

    "ReplicatedFirst": {
      "First": {
        "$path": "src/first"
      }
    },

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "StarterPlayer": {
      "$properties": {
        "CharacterUseJumpPower": false,
        "CharacterJumpHeight": 0,
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "Workspace": {
      "$properties": {
        "FilteringEnabled": true,
        "AuthorityMode": "Server",
        "StreamingEnabled": true,
        "SignalBehavior": "Deferred",
        "StreamOutBehavior": "Opportunistic",
        "StreamingIntegrityMode": "PauseOutsideLoadedArea",
        "ModelStreamingBehavior": "Improved"
      }
    },

    "Lighting": {
      "$properties": {
        "Ambient": [0, 0, 0],
        "Brightness": 2,
        "GlobalShadows": true,
        "Outlines": false,
        "Technology": "ShadowMap"
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
